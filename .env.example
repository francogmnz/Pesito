# Sin estas dos variables la app corre en MODO DEMO (datos de ejemplo en memoria).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor: tareas automáticas (ingesta de fuentes y vencimientos). Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (para el enlace de ingreso por email).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protege /api/cron/actualizar (mínimo 16 caracteres). Mandalo como "Authorization: Bearer ...".
CRON_SECRET=

# Sal para anonimizar IPs en los límites antispam.
IP_HASH_SALT=

# Opcional: lectura de capturas con IA en "Sugerí una promo".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
